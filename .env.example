# Copy to .env (never commit .env)
OPENROUTER_API_KEY=
MODEL=openrouter/google/gemini-2.5-flash
MEM0_API_KEY=

# Postgres (docker-compose.yml). Admin is only for setup; the Toolbox uses the least-privilege user.
POSTGRES_USER=shop_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=shop
POSTGRES_PORT=5433
TOOLBOX_DB_USER=toolbox_user
TOOLBOX_DB_PASSWORD=change-me-toolbox
